{
  "name": "@polly-fe/design-foundations",
  "version": "2.0.1",
  "description": "Framework-agnostic design primitives including icon fonts, global styles, typography, and shared CSS utilities used across Polly microfrontends.",
  "license": "ISC",
  "type": "module",
  "main": "./dist/styles/index.css",
  "style": "./dist/styles/index.css",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/styles/index.css",
    "./styles": "./dist/styles/index.css",
    "./fonts/*": "./dist/fonts/*"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && mkdir -p dist && cp -r src/* dist/",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests specified\" && exit 0",
    "lint": "echo \"No linting specified\" && exit 0",
    "version:patch": "npm version patch && npm publish",
    "version:minor": "npm version minor && npm publish",
    "version:major": "npm version major && npm publish"
  }
}
